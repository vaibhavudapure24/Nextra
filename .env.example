# Wildlife Monitoring System Environment Configuration
ENVIRONMENT=development

# Database Settings (PostgreSQL with automatic fallback)
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=wildlife_db
DATABASE__USER=postgres
DATABASE__PASSWORD=postgres

# API Settings
API__HOST=0.0.0.0
API__PORT=8000
API_SECRET_KEY=change_this_in_production_secret_key_wildlife_2026

# Detection & AI Device
DETECTION__MODEL_TYPE=yolo11
DETECTION__DEVICE=auto
DETECTION__CONFIDENCE_THRESHOLD=0.40

# Email Alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ranger_alerts@wildlife-reserve.org
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_RECIPIENTS=team@wildlife-reserve.org

# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Twilio SMS Alerts
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
ALERT_PHONE_NUMBER=+1987654321

# Integrations
DRONE_MAVLINK_CONNECTION=udp:0.0.0.0:14550
GPS_SERIAL_PORT=/dev/ttyUSB0
RFID_SERIAL_PORT=/dev/ttyUSB1

# ==============================================================================
# GPU-enabled variant. Requires the NVIDIA Container Toolkit on the host
# (nvidia-docker2) and `--gpus all` (or the `deploy.resources` block already
# present in docker-compose.yml under the `app-gpu` service).
# ==============================================================================

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3-pip python3.12-venv \
        libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
        libpq-dev gcc ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/bin/python

COPY requirements.txt .
# torch/torchvision here should match your CUDA driver; adjust the index URL
# if you need a different CUDA build (see https://pytorch.org/get-started/locally/)
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir torch==2.4.0 torchvision==0.19.0 --index-url https://download.pytorch.org/whl/cu121 \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir onnxruntime-gpu==1.18.1

COPY . .

RUN mkdir -p logs outputs models datasets

EXPOSE 8000 8501

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
